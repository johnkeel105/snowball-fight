textures/cobra_tex2/rubble_rock1
{
	qer_keyword stone
	qer_keyword stone
	surfaceparm stone
	{
		map textures/cobra_tex2/rubble_rock1.jpg
		depthWrite
		rgbGen identity
	}
	{
		map $lightmap
		rgbGen identity
		blendFunc GL_DST_COLOR GL_ZERO
		depthFunc equal
	}
}

