//Stalingrad Snow MAP by Chris Murchison aka General Cobra Command.
main:

setcvar "g_obj_alliedtext1" "STALINGRAD SNOW"
setcvar "g_obj_alliedtext2" "By Gen Cobra"
setcvar "g_obj_alliedtext3" "Chris Murchison"
setcvar "g_obj_axistext1" ""
setcvar "g_obj_axistext2" ""
setcvar "g_obj_axistext3" ""
 
setcvar "g_scoreboardpic" "textures/mohmenu/dmloading/stalingradsnow_loading"

	// call additional stuff for playing this map round based is needed
	if(level.roundbased)
		thread roundbasedthread
	exec global/door_locked.scr	
	level waittill prespawn
	//*** Precache Dm Stuff
	exec global/DMprecache.scr
	level.script = maps/dm/stalingradsnow.scr
	exec global/ambient.scr stalingradsnow  
        level waittill spawn

exec global/snowcontest.scr
wait 2

if(local.string[25] == "2")
{
level.rain_speed = "60"
level.rain_speed_vary = "2"
level.rain_length = "2"
level.rain_width = "1"
level.rain_density = "5"
level.rain_slant = "1"
level.rain_min_dist = "768"
level.rain_numshaders = 12
level.rain_shader = "textures/snow"
}
else
{
level.rain_speed = "32"
level.rain_speed_vary = "16"
level.rain_length = "2"
level.rain_width = "1"
level.rain_density = ".8"
level.rain_slant = "250"
level.rain_min_dist = "768"
level.rain_numshaders = 12
level.rain_shader = "textures/snow0"
}
end

pain:
          $hurtme volumedamage 5
end

roundbasedthread:

	level waitTill prespawn

	level waittill spawn

	level.dmrespawning = 0 // 1 or 0
	level.dmroundlimit = 5 // round time limit in minutes
	level.clockside = kills // set to axis, allies, kills, or draw

	level waittill roundstart

end
