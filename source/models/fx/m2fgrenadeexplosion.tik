TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}
 
init
{
	server  
	{
		classname Explosion
//		ghost
//		svflags +sendonce
		rendereffects +dontdraw
		notsolid
		radiusdamage 100
		radius 20
		meansofdeath thrownobject
		life 0.1
	}
}

animations
{
	idle dummy2.skc
	{
		server    
		{
			// make the explosion effect
//			entry explosioneffect grenade
			//first explosioneffect grenade

//			last stopanimating
			first sound snd_landing_snow weapon
		}
		client
		{
			first sound snd_landing_snow weapon
			
			sfx originspawn
			(
				model bh_snow_puff.spr
				count 15
				color 1.00 1.00 1.00
				spritegridlighting
				scale 0.25
				life 2.00
				collision
				scalerate 1.01
				velocity 45.00
				fade
				accel 0.00 0.00 -600.00
				offsetalongaxis 0 0 25
				sphere
			)
	
			sfx originspawn
			(
				spawnrate 1.00
				model oceanspray.spr
				count 8
				alpha 0.60
				color 1.00 1.00 1.00
				spritegridlighting
				scale 0.20
				life 0.40
				scalerate 1.4
				radius 70.00
				velocity 400.00
				randvel 0 crandom -90 0
				accel 0.00 0.00 -700.00
				angles 0 0 crandom -100
				avelocity 0 0 crandom -180
				fadedelay 0.00
				sphere
			)	
		}
	}
}
