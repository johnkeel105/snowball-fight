TIKI
setup
{
path models/human/german_misc_scientist	// Set path to set skelmodel from
	skelmodel scientist.skd			// Set body model

	surface coat shader allied_old_woman_coat
	surface pants shader allied_old_woman_pants
	surface inside shader allied_old_woman_pants
	surface cull_coat shader cull_allied_old_woman_coat
	surface cull_pants shader cull_allied_old_woman_pants

	path models/human/heads
	skelmodel manon_head.skd
	surface manon shader allied_old_woman_face

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype manon // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
